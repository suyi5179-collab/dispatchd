{
 "uid": "dispatchd",
 "title": "dispatchd",
 "schemaVersion": 39,
 "version": 1,
 "time": {
  "from": "now-15m",
  "to": "now"
 },
 "refresh": "5s",
 "panels": [
  {
   "type": "timeseries",
   "title": "Queue depth: Kafka consumer lag",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic) (dispatchd_kafka_consumer_lag)",
     "legendFormat": "{{topic}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Waiting outside Kafka: outbox + delay queue",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "dispatchd_outbox_unpublished",
     "legendFormat": "outbox unpublished",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "sum(dispatchd_delay_queue_size)",
     "legendFormat": "delay queue (retries)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Delivery latency (accepted \u2192 delivered)",
   "gridPos": {
    "x": 0,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le, channel) (rate(dispatchd_delivery_latency_seconds_bucket[1m])))",
     "legendFormat": "p50 {{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.99, sum by (le, channel) (rate(dispatchd_delivery_latency_seconds_bucket[1m])))",
     "legendFormat": "p99 {{channel}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Attempts per second by outcome",
   "gridPos": {
    "x": 12,
    "y": 8,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, outcome) (rate(dispatchd_attempts_total[1m]))",
     "legendFormat": "{{provider}} {{outcome}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Error rate by provider",
   "gridPos": {
    "x": 0,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (rate(dispatchd_attempts_total{outcome!=\"DELIVERED\"}[1m])) / sum by (provider) (rate(dispatchd_attempts_total[1m]))",
     "legendFormat": "{{provider}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Errors by kind and code",
   "gridPos": {
    "x": 12,
    "y": 16,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider, kind, code) (rate(dispatchd_provider_errors_total[1m]))",
     "legendFormat": "{{provider}} {{kind}} {{code}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Token bucket wait p99 and balance",
   "gridPos": {
    "x": 0,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.99, sum by (le, provider) (rate(dispatchd_ratelimit_wait_seconds_bucket[1m])))",
     "legendFormat": "wait p99 {{provider}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "dispatchd_ratelimit_tokens",
     "legendFormat": "tokens {{provider}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Retries, duplicates, lease expiries",
   "gridPos": {
    "x": 12,
    "y": 24,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (provider) (rate(dispatchd_retries_scheduled_total[1m]))",
     "legendFormat": "retries scheduled {{provider}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "B",
     "expr": "rate(dispatchd_duplicate_messages_skipped_total[1m])",
     "legendFormat": "duplicate Kafka messages skipped",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "C",
     "expr": "rate(dispatchd_lease_expired_total[1m])",
     "legendFormat": "leases expired",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    },
    {
     "refId": "D",
     "expr": "rate(dispatchd_idempotent_replays_total[1m])",
     "legendFormat": "idempotent replays (API)",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Delay queue wake-ups",
   "gridPos": {
    "x": 0,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (reason) (rate(dispatchd_delay_queue_wakeups_total[1m]))",
     "legendFormat": "{{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  },
  {
   "type": "timeseries",
   "title": "Final statuses",
   "gridPos": {
    "x": 12,
    "y": 32,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "reqps"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (channel, status) (rate(dispatchd_notifications_final_total[1m]))",
     "legendFormat": "{{channel}} {{status}}",
     "datasource": {
      "type": "prometheus",
      "uid": "prom"
     }
    }
   ]
  }
 ],
 "tags": [
  "dispatchd"
 ]
}