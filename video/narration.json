[
 {
  "id": "s01",
  "part": "p1-intake",
  "action": "open",
  "highlight": ".learn-head h2",
  "text": "这一段讲通知怎么被收下。我们跟着一个真实的通知，从提交一直走到送达。"
 },
 {
  "id": "s02",
  "part": "p1-intake",
  "action": "show",
  "highlight": "[data-testid=timeline]",
  "text": "左边是十个阶段。每一步亮起来，是因为后端真的在数据库里写下了那一行，不是前端在播动画。"
 },
 {
  "id": "s03",
  "part": "p1-intake",
  "action": "click:[data-testid=learn-start]",
  "highlight": "[data-testid=learn-start]",
  "text": "我点提交样例。后端会发一个真实的通知请求，带一个新的幂等键。为了演示重试，provider 会让这个收件人的第一次请求失败。"
 },
 {
  "id": "s04",
  "part": "p1-intake",
  "action": "select:submit",
  "highlight": "[data-testid=step-detail] [data-testid=idem-key-value]",
  "text": "先看这里，这就是这次请求带的幂等键。为什么先看它？调用方超时以后重试，必须带同一个键，服务端才认得出这是同一件事。"
 },
 {
  "id": "s05",
  "part": "p1-intake",
  "action": "show",
  "highlight": "[data-testid=step-detail] [data-testid=submit-code]",
  "text": "响应码是二百零二，意思是收下了，但还没发。通知服务是异步的，调用方不用等投递完成。",
  "shape": "circle"
 },
 {
  "id": "s06",
  "part": "p1-intake",
  "action": "select:idempotency",
  "highlight": "[data-testid=step-detail] [data-testid=idem-row]",
  "text": "第二步是幂等检查。这是数据库里幂等键表的那一行，主键是调用方加上幂等键。"
 },
 {
  "id": "s07",
  "part": "p1-intake",
  "action": "show",
  "highlight": "[data-testid=step-detail] [data-testid=idem-hash]",
  "text": "这一列是请求体的指纹。同一个键再来一次，指纹一样就返回第一次的结果，不一样就拒绝。为什么不先查后插？因为重试经常和第一次同时到，两个请求都会查到没有。这一段就讲到这里。"
 },
 {
  "id": "s08",
  "part": "p2-outbox",
  "action": "select:persist",
  "highlight": "[data-testid=step-detail] [data-testid=persist-status]",
  "text": "这一段讲通知怎么进队列。先看这里，通知这一行的状态是排队中。"
 },
 {
  "id": "s09",
  "part": "p2-outbox",
  "action": "show",
  "highlight": "[data-testid=step-detail] [data-testid=outbox-topic]",
  "text": "再看右边，outbox 表里同时多了一行，写着要发到哪个 topic。两行在同一个事务里提交，要么都在，要么都不在。"
 },
 {
  "id": "s10",
  "part": "p2-outbox",
  "action": "show",
  "highlight": "[data-testid=step-detail] [data-testid=outbox-created]",
